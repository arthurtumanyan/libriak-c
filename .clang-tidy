# misc-no-recursion is off: CRDT maps nest, and the recursion over them is
# bounded (MAX_DEPTH in src/datatype.c).
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-assignment-in-if-condition,
  cert-*,
  clang-analyzer-*,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  misc-*,
  -misc-include-cleaner,
  -misc-no-recursion,
  performance-*,
  portability-*
WarningsAsErrors: ''
HeaderFilterRegex: '(include|src)/.*'
