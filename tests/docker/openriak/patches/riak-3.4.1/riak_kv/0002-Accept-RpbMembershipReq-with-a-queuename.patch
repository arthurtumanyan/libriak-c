From 9fbfcaf10aef2f306b2caeec01dbc0caf1b09730 Mon Sep 17 00:00:00 2001
From: Arthur Tumanyan <arthurtumanyan@gmail.com>
Date: Thu, 29 Oct 2026 11:09:34 +0400
Subject: [PATCH] Accept RpbMembershipReq with a queuename

RpbMembershipReq has an optional queuename field. riak_pb_codec decodes a
request without fields to the bare atom rpbmembershipreq, the only form
riak_kv_pb_object:process/2 matched; a request with queuename set decoded
to #rpbmembershipreq{} and failed with function_clause, so the client got
"Error processing incoming message" and a closed connection instead of the
membership.

The record is now answered like the empty request; the queue name does not
change the result. A test sends the request with and without queuename
over a PB connection.
---
 src/riak_kv_pb_object.erl | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/src/riak_kv_pb_object.erl b/src/riak_kv_pb_object.erl
index 58a26881..f60986dd 100644
--- a/src/riak_kv_pb_object.erl
+++ b/src/riak_kv_pb_object.erl
@@ -275,6 +275,10 @@ process(#rpbpushreq{queuename = QueueNameBin, keys_value = KVL}, State) ->
                 State}
     end;
 
+process(#rpbmembershipreq{}, State) ->
+    % The queuename field does not change the answer: membership is that of
+    % the cluster.  A request without fields decodes to the bare atom.
+    process(rpbmembershipreq, State);
 process(rpbmembershipreq, State) ->
     MembershipList =
         lists:map(
@@ -662,6 +666,21 @@ empty_bucket_key_test_() ->
        ?_assertMatch([0|_], request(#rpbgetreq{bucket = <<>>,
                                                key = <<"foo">>}))}]}.
 
+membership_request_test_() ->
+    Name = "membership_request_test",
+    SetupFun =  fun (load) ->
+                        application:set_env(riak_kv, storage_backend, riak_kv_memory_backend),
+                        application:set_env(riak_api, pb_ip, "127.0.0.1"),
+                        application:set_env(riak_api, pb_port, 32767);
+                    (_) -> ok end,
+    {setup,
+     riak_kv_test_util:common_setup(Name, SetupFun),
+     riak_kv_test_util:common_cleanup(Name, SetupFun),
+     [{"RpbMembershipReq without a body is answered",
+       ?_assertMatch([207|_], request(?CODE(rpbmembershipreq), <<>>))},
+      {"RpbMembershipReq with a queuename is answered",
+       ?_assertMatch([207|_], request(#rpbmembershipreq{queuename = <<"q">>}))}]}.
+
 %% Utility funcs copied from riak_api/test/pb_service_test.erl
 
 request(Msg) when is_tuple(Msg) andalso is_atom(element(1, Msg)) ->
